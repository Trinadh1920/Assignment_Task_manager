# PostgreSQL is required because the Prisma datasource uses the PostgreSQL provider.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/team_task_manager?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3000

# Development only. Leave blank in production to use same-origin /api calls.
VITE_API_URL="http://localhost:3000"
